{
  "name": "nuxtwarp",
  "version": "1.0.0",
  "description": "Code generation CLI for Nuxt 3 modules with TypeScript",
  "type": "module",
  "main": "./bin/nuxtwarp.js",
  "bin": {
    "nuxtwarp": "./bin/nuxtwarp.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "test": "vitest"
  },
  "keywords": [
    "nuxt",
    "cli",
    "generator",
    "typescript",
    "code-generation"
  ],
  "author": "OmniNuxt Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "defu": "^6.1.3",
    "dotenv": "^16.3.1",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "pathe": "^1.1.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
